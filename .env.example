# ──────────────────────────────────────────────────────────────────────────
# Career OS — environment configuration
# Copy this file to ".env" and fill in the values for your machine.
#   cp .env.example .env        (or run `make run` / `make docker-up`, which copy it for you)
# ".env" is git-ignored — never commit real secrets.
# ──────────────────────────────────────────────────────────────────────────

# Anthropic API key — optional. Enables cloud Claude scoring.
# Leave blank to run fully local (Ollama only). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model for the cheap Claude calls (scoring + keyword extraction). Haiku = ~5x cheaper
# than Opus and fine for fit-scoring. Set to claude-opus-4-8 for max quality.
SCORING_MODEL=claude-haiku-4-5
# USD->NZD rate for the dashboard cost estimate. Update as the rate moves.
USD_TO_NZD=1.67

# REQUIRED. Absolute path to the Obsidian vault used as the datastore.
# Windows example: C:\Users\you\Documents\MyVault
# macOS/Linux example: /Users/you/Obsidian/MyVault
VAULT_PATH=

# "Show files" host path. When the server runs in a container, VAULT_PATH (e.g. /vault)
# means nothing to your desktop, so the button can't open the folder. Set this to the
# location the vault maps to as seen from YOUR machine and "Show files" returns the
# per-application path under it (copied to your clipboard) to paste into Explorer.
# SMB share example: \\nas\appdata\obsidian\MyVault
# Leave BLANK when running natively (the button opens the folder directly instead).
REVEAL_HOST_PATH=

# ── Outlook / Microsoft 365 ingestion ─────────────────────────────────────
# Option A: Microsoft Graph (recommended). Register an Azure AD app, grant Mail.Read.
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=
GRAPH_CLIENT_SECRET=
# Mail folder your job-alert emails are filtered into
GRAPH_MAIL_FOLDER=JobAlerts

# Option B: IMAP fallback (Outlook IMAP + app password)
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=JobAlerts

# Which ingest source to use: graph | imap | file
#   file = parse .eml/.txt alert files from ./inbox (dev/offline mode)
INGEST_SOURCE=file
# Folder scanned for alert files when INGEST_SOURCE=file (relative to the app, or absolute)
INBOX_DIR=inbox

# ── ZEIL job marketplace ──────────────────────────────────────────────────
# ZEIL (app.zeil.com) has no anonymous access — searching needs YOUR job-seeker
# account. Career-OS signs in via AWS Cognito SRP to mint a short-lived token, then
# calls the same search API the app uses (no browser). Leave blank to disable ZEIL.
# Add "zeil" to the `sites:` list in Career/Profile/job-search.md to enable it.
ZEIL_EMAIL=
ZEIL_PASSWORD=

# ── Dashboard + scheduler ─────────────────────────────────────────────────
# Local dashboard port (bound to 127.0.0.1 only)
DASHBOARD_PORT=8787
# Bind host. 127.0.0.1 = loopback-only (default, native runs). The Docker/Unraid targets
# set this to 0.0.0.0 inside the container and publish the port to 127.0.0.1 on the host,
# so it stays local-only either way.
DASHBOARD_HOST=127.0.0.1
# Auto-run the read-side pipeline daily? true|false
SCHEDULE_ENABLED=false
# Local time (HH:MM) for the daily auto-run
SCHEDULE_TIME=08:00

# ── Local LLM (Ollama) for scoring + resume/cover tailoring ───────────────
# Where Ollama listens. In Docker/Unraid, Ollama runs on the host, not in the container,
# so use http://host.docker.internal:11434 (the docker-* targets set this automatically).
OLLAMA_URL=http://localhost:11434
# Writing model — tailors the resume + cover letter (two calls per application, so quality
# is worth the latency). Bigger = better instruction-following. qwen3:32b q4 ~20GB (24GB GPU,
# or partial offload); qwen3:30b-a3b (MoE, ~3B active) is much faster; qwen3:14b for smaller GPUs.
OLLAMA_MODEL=qwen3:32b
# Scoring model — one call per job, and a search run scores HUNDREDS of them, so latency
# dominates here. qwen3:32b takes ~55s/job (a 200-job run = ~3 hours) and a small model cuts
# that to seconds — but scoring decides what clears min_fit_to_keep and reaches the board, so
# a weaker scorer silently drops real jobs rather than merely reordering them. Validate first:
#   npx tsx scripts/score-agreement.ts qwen3:8b 20
# It replays recorded fits from your own vault and reports how many jobs change Kept/Dropped.
# Leave blank to reuse OLLAMA_MODEL.
OLLAMA_SCORE_MODEL=
# Jobs scored concurrently. Ollama serialises inference anyway unless OLLAMA_NUM_PARALLEL
# says otherwise, so this only overlaps one job's vault write with the next job's inference.
# Defaults to 6 with an ANTHROPIC_API_KEY set, else 2.
SCORE_CONCURRENCY=

# ── Logging ───────────────────────────────────────────────────────────────
# Verbose diagnostics (per-site/per-job timings, scorer path, convert details).
# On by default; set to 0 to quiet down to the high-level lines only.
LOG_VERBOSE=1
# Write a rotating, timestamped log file to this dir. Leave BLANK for console-only
# (native default). The container image sets LOG_DIR=/logs automatically.
LOG_DIR=
# Rotation: roll over at this size, keeping this many archives (career-os.log.1..N).
LOG_MAX_BYTES=5242880
LOG_MAX_FILES=5
